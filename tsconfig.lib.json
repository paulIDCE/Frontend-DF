{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "./dist/types",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": [
    "src/demos",
    "src/modulos",
    "src/auth",
    "src/routes",
    "src/services",
    "src/interceptors",
    "src/mocks",
    "src/config",
    "src/App.tsx",
    "src/home.tsx",
    "src/main.tsx"
  ]
}
