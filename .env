# App servida: el puerto y la bandera de desarrollo.
#
# Las URLs de las APIs NO van aqui — se cargan en runtime desde
# public/config/routes.json (ver docs/CONVENCIONES_FRONTEND.md §4).
PORT=3000

# Ayudas de desarrollo (src/config/desarrollo.ts): con true se ve de donde sale cada dato
# (banda de origen, insignias BD / JSON / Mixto, marcas por fila, KPI y grafica). Para desplegar,
# false: los avisos desaparecen sin tocar el codigo. Cambiarla pide reiniciar `pnpm dev`.
VITE_DEVELOPMENT=true
